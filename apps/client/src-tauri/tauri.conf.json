{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zhiya",
  "version": "0.1.0",
  "identifier": "com.lanterncx.zhiya",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "知芽 Zhiya",
        "width": 1024,
        "height": 768,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; frame-src 'self' https://player.bilibili.com; connect-src 'self' ipc: http://ipc.localhost https: wss: http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "dmg"],
    "icon": ["icons/128x128.png"],
    "macOS": { "signingIdentity": "-" },
    "windows": {
      "webviewInstallMode": { "type": "embedBootstrapper" },
      "nsis": { "languages": ["SimpChinese", "English"], "displayLanguageSelector": true }
    }
  }
}
