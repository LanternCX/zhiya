{
  "name": "@zhiya/website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test:e2e": "npm run build && playwright test",
    "test:pages": "npm run build:pages && playwright test --config playwright.pages.config.ts",
    "build:pages": "npm run check && vite build --mode pages",
    "preview:pages": "vite preview --mode pages --host 127.0.0.1 --port 4175 --strictPort",
    "preview:test": "vite preview --host 127.0.0.1 --port 4174 --strictPort",
    "build": "npm run check && vite build"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
